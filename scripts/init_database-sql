/*
-----------------------------------------------------------------------------
Create Database and Schemas
-----------------------------------------------------------------------------
Script purpose:
  This script creates a new database named 'DataWarehouse' after checking is it already exists.
  If the database exists, it is dropped and recreated. Also, the script sets up three schemas within
  the database: 'bronze','silver' and 'gold'
  */

--sql
USE master;
GO

IF EXISTS (SELECT 1 FROM sys.databases WHERE name = 'DataWarehouse') 
BEGIN 
	DROP DataWarehouse; 
END;

--Create Database 'DataWarehouse'
CREATE DATABASE DataWarehouse;
GO 

USE DataWarehouse;
GO

-- Create Schemas
CREATE SCHEMA bronze;
GO

CREATE SCHEMA silver;
GO

CREATE SCHEMA gold;
GO
--
